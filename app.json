{
  "expo": {
    "name": "Laundly",
    "slug": "laundly",
    "scheme": "laundly",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/brand/laundly-icon.png",
    "ios": {
      "supportsTablet": true
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/brand/laundly-icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-image",
      "expo-font"
    ]
  }
}
